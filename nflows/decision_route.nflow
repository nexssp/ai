@description "Decision-router with explicit decision and candidate preflights, typed prompt attempts, and transient-only fallback"
@require ../ as ai {
    api_key_env: "AI_PROVIDER_API_KEY",
    decision_api_key_env: "AI_DECISION_API_KEY",
    timeout: "30s"
}

# The caller supplies decision_* fields, including decision_max_output_tokens,
# decision_allowed_ids, and decision_questions, plus candidate_a/candidate_b.
# Each candidate has {id, description, attempt:{candidate_id, attempt_id, provider,
# model, base_url?, rate_card_id, expected_currency, prompt_tokens,
# cached_prompt_tokens?, completion_tokens, user, system?, max_tokens?, ...}}.
# Provider/model/card/currency/attempt identifiers are never defaulted here.

@schema DecisionCandidateAttempt {
    candidate_id string
    attempt_id string
    provider string
    model string
    base_url *string
    rate_card_id string
    expected_currency string
    prompt_tokens int
    cached_prompt_tokens *int
    completion_tokens int
    user string
    system *string
    max_tokens *int
    temperature *float64
    json_mode *bool
    reasoning_effort *string
}

@schema DecisionCandidate {
    id string
    description string
    attempt DecisionCandidateAttempt
}

@schema DecisionCriterion {
    id string
    description string
}

@schema DecisionQuestion {
    id string
    type string
    instructions string
    criteria []DecisionCriterion
}

@schema DecisionRouteState {
    task string
    request string
}

@schema DecisionRouteActionInput {
    attempt_id string
    provider string
    model string
    base_url *string
    rate_card_id string
    expected_currency string
    prompt_tokens int
    cached_prompt_tokens *int
    completion_tokens int
    max_output_tokens int
    state DecisionRouteState
    allowed_ids []string
    questions []DecisionQuestion
    candidates []DecisionCandidate
}

@schema DecisionRouteRequest {
    task string
    request string
    decision_attempt_id string
    decision_provider string
    decision_model string
    decision_base_url *string
    decision_rate_card_id string
    decision_expected_currency string
    decision_prompt_tokens int
    decision_cached_prompt_tokens *int
    decision_max_output_tokens int
    decision_allowed_ids []string `validate:"required,min=1"`
    decision_questions []DecisionQuestion `validate:"required,min=1"`
    candidate_a DecisionCandidate
    candidate_b DecisionCandidate
}

@schema DecisionFallbackInput {
    attempt DecisionCandidateAttempt
}

@schema DecisionPrimaryInput {
    primary DecisionCandidateAttempt
    fallback DecisionCandidateAttempt
}

@schema DecisionPromptInput {
    candidate_id string
    attempt_id string
    rate_card_id string
    expected_currency *string
    prompt_tokens int
    cached_prompt_tokens *int
    completion_tokens int
    user string
    system *string
    provider string
    model string
    base_url *string
    max_tokens *int
    temperature *float64
    json_mode *bool
    reasoning_effort *string
    fallback *DecisionCandidateAttempt
}

@pipeline decision_route_run_prompt
  :request-schema=!DecisionPromptInput
    ai.prompt
@end

@pipeline decision_route_decide
  :request-schema=!DecisionRouteActionInput
    ai.decide
      -> ai.nflow.view
@end

@pipeline fallback_attempt
  :request-schema=!DecisionFallbackInput
    {
        .attempt.candidate_id,
        .attempt.attempt_id,
        .attempt.model,
        .attempt.rate_card_id,
        .attempt.expected_currency,
        .attempt.prompt_tokens,
        .attempt.cached_prompt_tokens,
        .attempt.completion_tokens,
        prompt: {
            .attempt.candidate_id,
            .attempt.attempt_id,
            .attempt.provider,
            .attempt.model,
            .attempt.rate_card_id,
            .attempt.expected_currency,
            .attempt.prompt_tokens,
            .attempt.cached_prompt_tokens,
            .attempt.completion_tokens,
            .attempt.base_url,
            .attempt.user,
            .attempt.system,
            .attempt.max_tokens,
            .attempt.temperature,
            .attempt.json_mode,
            .attempt.reasoning_effort
        }
    }
    -> ai.cost.estimate
    -> ai.nflow.view as cost_view
    -> match {
        cost_view.known == false
          -> {status: "fallback_preflight_rejected", .candidate_id, .attempt_id, .issue, provider_called: false},
        cost_view.known == true
          -> {
            candidate_id: __root__.prompt.candidate_id,
            attempt_id: __root__.prompt.attempt_id,
            user: __root__.prompt.user,
            system: __root__.prompt.system,
            provider: __root__.prompt.provider,
            model: __root__.prompt.model,
            rate_card_id: __root__.prompt.rate_card_id,
            expected_currency: __root__.prompt.expected_currency,
            prompt_tokens: __root__.prompt.prompt_tokens,
            cached_prompt_tokens: __root__.prompt.cached_prompt_tokens,
            completion_tokens: __root__.prompt.completion_tokens,
            base_url: __root__.prompt.base_url,
            max_tokens: __root__.prompt.max_tokens,
            temperature: __root__.prompt.temperature,
            json_mode: __root__.prompt.json_mode,
            reasoning_effort: __root__.prompt.reasoning_effort
        }
          -> pipeline.decision_route_run_prompt
    }
@end

@pipeline primary_prompt
  :request-schema=!DecisionPromptInput
    ai.prompt ? on_error {
        xerr.KindTimeout
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        xerr.KindUnavailable
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        xerr.KindCircuitBreaker
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        xerr.KindRateLimit
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        xerr.KindTooManyRequests
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        else
          -> error.reraise
    }
@end

@pipeline primary_attempt
  :request-schema=!DecisionPrimaryInput
    {
        .primary.candidate_id,
        .primary.attempt_id,
        .primary.model,
        .primary.rate_card_id,
        .primary.expected_currency,
        .primary.prompt_tokens,
        .primary.cached_prompt_tokens,
        .primary.completion_tokens,
        prompt: {
            .primary.candidate_id,
            .primary.attempt_id,
            .primary.provider,
            .primary.model,
            .primary.rate_card_id,
            .primary.expected_currency,
            .primary.prompt_tokens,
            .primary.cached_prompt_tokens,
            .primary.completion_tokens,
            .primary.base_url,
            .primary.user,
            .primary.system,
            .primary.max_tokens,
            .primary.temperature,
            .primary.json_mode,
            .primary.reasoning_effort,
            .fallback
        }
    }
    -> ai.cost.estimate
    -> ai.nflow.view as cost_view
    -> match {
        cost_view.known == false
          -> {status: "primary_preflight_rejected", .candidate_id, .attempt_id, .issue, fallback_invoked: false},
        cost_view.known == true
          -> {
            candidate_id: __root__.prompt.candidate_id,
            attempt_id: __root__.prompt.attempt_id,
            user: __root__.prompt.user,
            system: __root__.prompt.system,
            provider: __root__.prompt.provider,
            model: __root__.prompt.model,
            rate_card_id: __root__.prompt.rate_card_id,
            expected_currency: __root__.prompt.expected_currency,
            prompt_tokens: __root__.prompt.prompt_tokens,
            cached_prompt_tokens: __root__.prompt.cached_prompt_tokens,
            completion_tokens: __root__.prompt.completion_tokens,
            base_url: __root__.prompt.base_url,
            max_tokens: __root__.prompt.max_tokens,
            temperature: __root__.prompt.temperature,
            json_mode: __root__.prompt.json_mode,
            reasoning_effort: __root__.prompt.reasoning_effort,
            fallback: __root__.prompt.fallback
        }
          -> pipeline.primary_prompt
    }
@end

@pipeline decision_route
  :request-schema=!DecisionRouteRequest
    {
        attempt_id: .decision_attempt_id,
        model: .decision_model,
        rate_card_id: .decision_rate_card_id,
        expected_currency: .decision_expected_currency,
        prompt_tokens: .decision_prompt_tokens,
        cached_prompt_tokens: .decision_cached_prompt_tokens,
        completion_tokens: .decision_max_output_tokens,
        decision: {
            attempt_id: .decision_attempt_id,
            provider: .decision_provider,
            model: .decision_model,
            rate_card_id: .decision_rate_card_id,
            expected_currency: .decision_expected_currency,
            prompt_tokens: .decision_prompt_tokens,
            cached_prompt_tokens: .decision_cached_prompt_tokens,
            completion_tokens: .decision_max_output_tokens,
            max_output_tokens: .decision_max_output_tokens,
            base_url: .decision_base_url,
            state: {.task, .request},
            allowed_ids: .decision_allowed_ids,
            questions: .decision_questions,
            candidates: [.candidate_a, .candidate_b]
        }
    }
    -> ai.cost.estimate
    -> ai.nflow.view as cost_view
    -> match {
        cost_view.known == false
          -> {status: "decision_preflight_rejected", .attempt_id, .issue, provider_called: false},
        cost_view.known == true
          -> {
            attempt_id: __root__.decision.attempt_id,
            provider: __root__.decision.provider,
            model: __root__.decision.model,
            rate_card_id: __root__.decision.rate_card_id,
            expected_currency: __root__.decision.expected_currency,
            prompt_tokens: __root__.decision.prompt_tokens,
            cached_prompt_tokens: __root__.decision.cached_prompt_tokens,
            completion_tokens: __root__.decision.completion_tokens,
            max_output_tokens: __root__.decision.max_output_tokens,
            base_url: __root__.decision.base_url,
            state: __root__.decision.state,
            questions: __root__.decision.questions,
            allowed_ids: __root__.decision.allowed_ids,
            candidates: __root__.decision.candidates
        }
          -> pipeline.decision_route_decide as decision_result
          -> match {
            decision_result.answers[0].choice == __root__.candidates[0].id
              -> {primary: __root__.candidates[0].attempt, fallback: __root__.candidates[1].attempt}
              -> pipeline.primary_attempt,
            decision_result.answers[0].choice == __root__.candidates[1].id
              -> {primary: __root__.candidates[1].attempt, fallback: __root__.candidates[0].attempt}
              -> pipeline.primary_attempt,
            _
              -> {status: "manual_review", reason: "decision_not_in_candidate_allowlist"}
          }
    }
@end

pipeline.decision_route
