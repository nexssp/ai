@description "Decision-router with explicit decision and candidate preflights, typed prompt attempts, and transient-only fallback"
@require ../ as ai {
    api_key_env: "AI_PROVIDER_API_KEY",
    decision_api_key_env: "AI_DECISION_API_KEY",
    timeout: "30s"
}

# The caller supplies decision_* fields, including decision_max_output_tokens,
# and candidate_a/candidate_b fields. Each
# candidate has {id, description, attempt:{candidate_id, attempt_id, provider,
# model, base_url?, rate_card_id, expected_currency, prompt_tokens,
# cached_prompt_tokens?, completion_tokens, user, system?, max_tokens?, ...}}.
# Provider/model/card/currency/attempt identifiers are never defaulted here.

@pipeline fallback_attempt
    {
        .attempt.candidate_id,
        .attempt.attempt_id,
        .attempt.model,
        .attempt.rate_card_id,
        .attempt.expected_currency,
        .attempt.prompt_tokens,
        .attempt.cached_prompt_tokens,
        .attempt.completion_tokens,
        prompt: {
            .attempt.candidate_id,
            .attempt.attempt_id,
            .attempt.provider,
            .attempt.model,
            .attempt.rate_card_id,
            .attempt.expected_currency,
            .attempt.prompt_tokens,
            .attempt.cached_prompt_tokens,
            .attempt.completion_tokens,
            .attempt.base_url,
            .attempt.user,
            .attempt.system,
            .attempt.max_tokens,
            .attempt.temperature,
            .attempt.json_mode,
            .attempt.reasoning_effort
        }
    }
    -> ai.cost.estimate
    -> ai.nflow.view as cost_view
    -> match {
        cost_view.known == false
          -> const @{status: "fallback_preflight_rejected", .candidate_id, .attempt_id, .issue, provider_called: false},
        cost_view.known == true
          -> {
            candidate_id: __root__.prompt.candidate_id,
            attempt_id: __root__.prompt.attempt_id,
            user: __root__.prompt.user,
            system: __root__.prompt.system,
            provider: __root__.prompt.provider,
            model: __root__.prompt.model,
            rate_card_id: __root__.prompt.rate_card_id,
            expected_currency: __root__.prompt.expected_currency,
            prompt_tokens: __root__.prompt.prompt_tokens,
            cached_prompt_tokens: __root__.prompt.cached_prompt_tokens,
            completion_tokens: __root__.prompt.completion_tokens,
            base_url: __root__.prompt.base_url,
            max_tokens: __root__.prompt.max_tokens,
            temperature: __root__.prompt.temperature,
            json_mode: __root__.prompt.json_mode,
            reasoning_effort: __root__.prompt.reasoning_effort
        }
          -> ai.prompt
    }
@end

@pipeline primary_prompt
    ai.prompt ? on_error {
        xerr.KindTimeout
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        xerr.KindUnavailable
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        xerr.KindCircuitBreaker
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        xerr.KindRateLimit
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        xerr.KindTooManyRequests
          -> {attempt: .input.fallback}
          -> pipeline.fallback_attempt,
        else
          -> error.reraise
    }
@end

@pipeline primary_attempt
    {
        .primary.candidate_id,
        .primary.attempt_id,
        .primary.model,
        .primary.rate_card_id,
        .primary.expected_currency,
        .primary.prompt_tokens,
        .primary.cached_prompt_tokens,
        .primary.completion_tokens,
        prompt: {
            .primary.candidate_id,
            .primary.attempt_id,
            .primary.provider,
            .primary.model,
            .primary.rate_card_id,
            .primary.expected_currency,
            .primary.prompt_tokens,
            .primary.cached_prompt_tokens,
            .primary.completion_tokens,
            .primary.base_url,
            .primary.user,
            .primary.system,
            .primary.max_tokens,
            .primary.temperature,
            .primary.json_mode,
            .primary.reasoning_effort,
            .fallback
        }
    }
    -> ai.cost.estimate
    -> ai.nflow.view as cost_view
    -> match {
        cost_view.known == false
          -> const @{status: "primary_preflight_rejected", .candidate_id, .attempt_id, .issue, fallback_invoked: false},
        cost_view.known == true
          -> {
            candidate_id: __root__.prompt.candidate_id,
            attempt_id: __root__.prompt.attempt_id,
            user: __root__.prompt.user,
            system: __root__.prompt.system,
            provider: __root__.prompt.provider,
            model: __root__.prompt.model,
            rate_card_id: __root__.prompt.rate_card_id,
            expected_currency: __root__.prompt.expected_currency,
            prompt_tokens: __root__.prompt.prompt_tokens,
            cached_prompt_tokens: __root__.prompt.cached_prompt_tokens,
            completion_tokens: __root__.prompt.completion_tokens,
            base_url: __root__.prompt.base_url,
            max_tokens: __root__.prompt.max_tokens,
            temperature: __root__.prompt.temperature,
            json_mode: __root__.prompt.json_mode,
            reasoning_effort: __root__.prompt.reasoning_effort,
            fallback: __root__.prompt.fallback
        }
          -> pipeline.primary_prompt
    }
@end

@pipeline decision_route
    {
        attempt_id: .decision_attempt_id,
        model: .decision_model,
        rate_card_id: .decision_rate_card_id,
        expected_currency: .decision_expected_currency,
        prompt_tokens: .decision_prompt_tokens,
        cached_prompt_tokens: .decision_cached_prompt_tokens,
        completion_tokens: .decision_max_output_tokens,
        decision: {
            attempt_id: .decision_attempt_id,
            provider: .decision_provider,
            model: .decision_model,
            rate_card_id: .decision_rate_card_id,
            expected_currency: .decision_expected_currency,
            prompt_tokens: .decision_prompt_tokens,
            cached_prompt_tokens: .decision_cached_prompt_tokens,
            completion_tokens: .decision_max_output_tokens,
            max_output_tokens: .decision_max_output_tokens,
            base_url: .decision_base_url,
            state: {.task, .request},
            allowed_ids: [.candidate_a.id, .candidate_b.id],
            questions: [{
                id: "route",
                type: "choice",
                instructions: "Select exactly one configured candidate ID.",
                criteria: [
                    {.candidate_a.id, .candidate_a.description},
                    {.candidate_b.id, .candidate_b.description}
                ]
            }],
            candidates: [.candidate_a, .candidate_b]
        }
    }
    -> ai.cost.estimate
    -> ai.nflow.view as cost_view
    -> match {
        cost_view.known == false
          -> const @{status: "decision_preflight_rejected", .attempt_id, .issue, provider_called: false},
        cost_view.known == true
          -> {
            attempt_id: __root__.decision.attempt_id,
            provider: __root__.decision.provider,
            model: __root__.decision.model,
            rate_card_id: __root__.decision.rate_card_id,
            expected_currency: __root__.decision.expected_currency,
            prompt_tokens: __root__.decision.prompt_tokens,
            cached_prompt_tokens: __root__.decision.cached_prompt_tokens,
            completion_tokens: __root__.decision.completion_tokens,
            max_output_tokens: __root__.decision.max_output_tokens,
            base_url: __root__.decision.base_url,
            state: __root__.decision.state,
            questions: __root__.decision.questions,
            allowed_ids: __root__.decision.allowed_ids,
            candidates: __root__.decision.candidates
        }
          -> ai.decide
                    -> ai.nflow.view as decision_result
                    -> match {
                decision_result.answers[0].choice == __root__.candidates[0].id
                  -> {primary: __root__.candidates[0].attempt, fallback: __root__.candidates[1].attempt}
                  -> pipeline.primary_attempt,
                decision_result.answers[0].choice == __root__.candidates[1].id
                  -> {primary: __root__.candidates[1].attempt, fallback: __root__.candidates[0].attempt}
                  -> pipeline.primary_attempt,
                _
                  -> const @{status: "manual_review", reason: "decision_not_in_candidate_allowlist"}
            }
    }
@end

pipeline.decision_route
